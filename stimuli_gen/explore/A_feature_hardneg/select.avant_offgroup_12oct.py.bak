"""Lens A_feature_hardneg: hard negatives in (standardized) DINOv2 feature space.

Rule (names are NEVER used in the selection; only the SAE code, the DINOv2 features, labels/categories):
  refs_high : 9 naming-split images walked by decreasing z_a among the top N_HIGH_POOL, skipping near-duplicates
              (cos > DUP_HIGH to an already chosen one), so that the row shows the variety of the concept
              without leaving it (farthest-point sampling was tried and rejected: it pulls in the outliers of the top-25).
  refs_low  : 9 naming-split images NEAREST (cosine) to the refs_high centroid among images on which the
              atom and all its namesakes are silent (z = 0) AND whose pre-code h_a is below H_MAX
              (default 0: the atom itself says "not the concept"), near-duplicates (cos > DUP) skipped,
              at most LOW_MAX_PER_CAT per category so that the row spans the category boundary instead of
              9 within-class look-alikes.
  query_pos / query_neg : positives = top N_POS_TOP held-out images by z_a with z_a >= Z_REL_MIN x max that sit
              INSIDE the concept region (closer to the refs_high centroid than the median refs_low image, and
              >= 3 of their 5 nearest references high); for each, the negatives are held-out images of the same
              category (same wnid / sharing >= 1 COCO label), silent on the atom and its namesakes with h_a < 0,
              restricted to the N_NEG_NEAR nearest to the positive. Every (pos, neg) pair gets the visual margin
              m1 (nearest-centroid score with the two reference rows); the pair kept is the one with the SMALLEST
              margin among those >= FLOOR with a positive kNN margin (solvable but hard). Cascade of fallbacks:
              same category with z = 0 only, then any category (nearest silent image).

Usage: python3 select.py            (writes metrics.json, contact_sheet.html, montage.png; embeds sweep.json if present)
       python3 select.py --sweep    (threshold sweep -> sweep.json; run it first)
Import: select_trial(D, a, rng, cfg=None) -> dict
"""
import os, sys
# this file is named select.py: keep its directory off sys.path so that the stdlib `select` stays importable
_HERE = os.path.dirname(os.path.abspath(__file__))
sys.path[:] = [p for p in sys.path if os.path.abspath(p or os.getcwd()) != _HERE]
for _v in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS'):
    os.environ.setdefault(_v, '4')
import json, math, re, time  # noqa: E402
import numpy as np  # noqa: E402

ROOT = '/lustre/work/pdl16831/udl5a0991/workspace/Supervised_concept_SAE'
GEN = f'{ROOT}/human_exp/stimuli_gen'
HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, GEN)
from make_stimuli import Data, load_names, N_REF, K, KEYS  # noqa: E402

CFG = dict(
    N_HIGH_POOL=25,     # refs_high drawn among the top-25 naming-split images by z_a
    HIGH_MODE='dedup',  # 'dedup' (top by z, near-duplicates skipped), 'fps' (farthest point sampling), 'top9' (baseline)
    DUP_HIGH=0.85,      # dedup: skip a candidate whose cos to an already chosen high ref exceeds this
    LOW_MAX_PER_CAT=3,  # refs_low: at most 3 images of one category (wnid / exact COCO label set)
    Z_REL_MIN=0.5,      # query_pos: z_a >= Z_REL_MIN * max held-out z_a (concept clearly present)
    POS_INSIDE=True,    # query_pos must be closer to the refs_high centroid than the median refs_low image is
    POS_KNN_MIN=0.6,    # and at least 3 of its 5 nearest references must be high (it looks like the concept)
    LOW_MODE='twin',    # 'twin' (12 Oct. 2026: one low image per high image, its nearest silent neighbour), 'hardneg' (9 nearest to the high centroid) or 'baseline' (9 lowest pre-code)
    H_MAX=0.0,          # refs_low: pre-code h_a must be < H_MAX (0 = the atom's own ReLU would kill it)
    DUP=0.95,           # skip near-duplicates (cos to an already chosen ref) in refs_low
    N_POS_TOP=10,       # query_pos candidates: top-10 held-out by z_a
    N_NEG_NEAR=30,      # per positive, negatives restricted to its 30 nearest silent same-category images
    FLOOR=0.02,         # keep the pair with the smallest centroid margin m1 >= FLOOR
    KNN_FLOOR=0.0,      # and whose kNN margin is > KNN_FLOOR (0 = strictly positive)
    KNN=5,
    PAIR_OBJ='min_margin',  # among admissible pairs: 'min_margin' (hardest solvable) or 'max_cos' (closest pair)
    H_NEG_MAX=0.0,      # query_neg: pre-code h_a must be < H_NEG_MAX (None = only z = 0 on the atom and namesakes)
    NEG_CAT=True,       # query_neg: True = same category first (cascade), False = nearest silent image of ANY category (variant b), 'different' = nearest silent image of a DIFFERENT category (variant c, 9 Oct. 2026)
)
SHEET_ATOMS = ["coco_2745", "coco_1210", "coco_3855", "coco_5723", "coco_821", "coco_2234",
               "imagenet_116", "imagenet_517", "imagenet_4351", "imagenet_3283", "imagenet_3022", "imagenet_2825"]


def log(*a):
    print(time.strftime('%H:%M:%S'), *a, flush=True)


# ---------------------------------------------------------------- feature-space helpers
class Prep:
    """Per-dataset precomputations attached to D (standardized + L2-normalised DINOv2 features, text for m5)."""

    def __init__(self, D):
        A = np.asarray(D.A, np.float32)
        Xs = (A - D.sc_mean) / D.sc_scale
        self.Xs = Xs
        self.Xn = Xs / np.maximum(np.linalg.norm(Xs, axis=1, keepdims=True), 1e-6)
        self.Xs_tr, self.Xn_tr, self.Xs_ev, self.Xn_ev = Xs[D.tr], self.Xn[D.tr], Xs[D.ev], self.Xn[D.ev]
        self.is_tr = np.zeros(D.N, bool); self.is_tr[D.tr] = True
        self.is_ev = np.zeros(D.N, bool); self.is_ev[D.ev] = True
        self.row_of_ev = {int(r): i for i, r in enumerate(D.ev.tolist())}
        caps = json.load(open(f'{D.CD}/caps_by_img.json'))
        i2c = json.load(open(f'{D.CD}/img_to_cats.json'))
        words = json.load(open(f'{D.CD}/img_to_words.json'))
        self.text = {}
        for r in range(D.N):
            kid = str(int(D.image_ids[r])) if D.key == 'coco' else str(r)
            t = ' '.join(caps.get(kid, [])) + ' ' + ' '.join(i2c.get(kid, [])) + ' ' + ' '.join(words.get(kid, []))
            if D.key == 'coco':
                t += ' ' + ' '.join(D.label_names[i] for i in np.where(D.labels[r])[0])
            self.text[r] = t.lower()
        if D.key == 'coco':
            self.id2row = {int(i): r for r, i in enumerate(D.image_ids.tolist())}

    def row_from_id(self, D, i):
        return self.id2row[int(i)] if D.key == 'coco' else int(i)


def prep(D):
    if not hasattr(D, 'P'):
        D.P = Prep(D)
    return D.P


def silent_mask(D, grp, rows):
    """True where atom a and its namesakes are all silent (z = 0) on the given rows."""
    return ~np.isin(D.z_idx[rows], np.asarray(grp)).any(1)


def h_rows(D, rows, a):
    P = prep(D)
    X = P.Xs_tr if rows is D.tr else P.Xs_ev if rows is D.ev else P.Xs[rows]
    return X @ D.We[a] + D.be[a]


def fps(Xn, cand, n, first):
    """Farthest point sampling (cosine) among cand, starting at `first`."""
    chosen = [first]
    rest = [c for c in cand if c != first]
    while len(chosen) < n and rest:
        S = Xn[rest] @ Xn[chosen].T          # len(rest) x len(chosen)
        j = int(np.argmin(S.max(1)))        # least similar to the closest chosen
        chosen.append(rest.pop(j))
    return chosen


def same_cat_mask(D, rows, pos):
    if D.key == 'imagenet':
        return D.wnid[rows] == D.wnid[pos]
    P = D.labels[pos]
    return (D.labels[rows] & P).any(1)


def jaccard_labels(D, r1, r2):
    if D.key == 'imagenet':
        return float(D.wnid[r1] == D.wnid[r2])
    a, b = D.labels[r1], D.labels[r2]
    u = (a | b).sum()
    return float((a & b).sum() / u) if u else 0.0


# ---------------------------------------------------------------- metrics
def unit(v):
    return v / max(np.linalg.norm(v), 1e-9)


def margins(D, refs_high, refs_low, q, knn=5):
    """Nearest-centroid score s(q) and kNN fraction f(q) of one query."""
    Xn = prep(D).Xn
    ch, cl = unit(Xn[refs_high].mean(0)), unit(Xn[refs_low].mean(0))
    s = float(Xn[q] @ ch - Xn[q] @ cl)
    refs = refs_high + refs_low
    sims = Xn[refs] @ Xn[q]
    nn = np.argsort(-sims)[:knn]
    f = float((nn < len(refs_high)).mean())
    return s, f


def word_in(name, text):
    n = name.lower().strip()
    if not n:
        return 0
    toks = [re.escape(t) for t in n.split()]
    pat = r'\b' + r'\s+'.join(t + r'(?:s|es)?' for t in toks) + r'\b'
    return int(re.search(pat, text) is not None)


def trial_metrics(D, a, refs_high, refs_low, pos, neg, names=None, knn=5):
    P = prep(D)
    Xn = P.Xn
    grp = getattr(D, 'namesakes', {}).get(a, [a])
    sp, fp = margins(D, refs_high, refs_low, pos, knn)
    sn, fn = margins(D, refs_high, refs_low, neg, knn)
    zcol = D.Zev[:, a]
    zmax = float(zcol.max()) if zcol.max() > 0 else 1.0
    m = dict(
        m1_margin=sp - sn, m1_knn=fp - fn, m1_sign=int(np.sign(sp - sn)), s_pos=sp, s_neg=sn,
        m2_z_pos_rel=D.z(pos, a) / zmax, m2_z_pos=D.z(pos, a), m2_z_neg=D.z(neg, a),
        m2_namesakes_silent=int(bool(silent_mask(D, grp, np.array([neg]))[0])), n_namesakes=len(grp),
        m3_code_jaccard=len(set(D.z_idx[pos].tolist()) & set(D.z_idx[neg].tolist())) / len(set(D.z_idx[pos].tolist()) | set(D.z_idx[neg].tolist())),
        m4_row_cos=float(unit(Xn[refs_high].mean(0)) @ unit(Xn[refs_low].mean(0))),
        pair_cos=float(Xn[pos] @ Xn[neg]), pair_label_jaccard=jaccard_labels(D, pos, neg),
        h_neg=float(h_rows(D, np.array([neg]), a)[0]),
        low_h_max=float(h_rows(D, np.array(refs_low), a).max()),
        high_mean_cos=float(np.mean((Xn[refs_high] @ Xn[refs_high].T)[np.triu_indices(len(refs_high), 1)])),
    )
    if D.key == 'imagenet':
        hw = set(D.wnid[refs_high].tolist())
        m['m4_same_cat_frac'] = float(np.mean([D.wnid[r] in hw for r in refs_low]))
    else:
        U = D.labels[refs_high].any(0)
        m['m4_same_cat_frac'] = float(np.mean([(D.labels[r] & U).any() for r in refs_low]))
    if names is not None:
        for k, nm in (('salt', names['salt']), ('cd', names['cd'])):
            ip, ineg = word_in(nm, P.text[pos]), word_in(nm, P.text[neg])
            m[f'm5_{k}'] = int(ip and not ineg); m[f'm5_{k}_in_pos'] = ip; m[f'm5_{k}_in_neg'] = ineg
    return m


# ---------------------------------------------------------------- the rule
def select_trial(D, a, rng, cfg=None):
    c = dict(CFG, **(cfg or {}))
    P = prep(D)
    Xn = P.Xn
    grp = getattr(D, 'namesakes', {}).get(a, [a])
    out = dict(atom=int(a), dataset=D.key, fallback=[])
    # --- refs_high
    top, topv = D.top_tr[a], D.top_tr_val[a]
    if (topv[:N_REF] <= 0).any():
        return None
    cand = [int(r) for r, v in zip(top[:c['N_HIGH_POOL']], topv[:c['N_HIGH_POOL']]) if v > 0]
    if c['HIGH_MODE'] == 'fps' and len(cand) > N_REF:
        refs_high = fps(Xn, cand, N_REF, cand[0])
    elif c['HIGH_MODE'] == 'dedup':
        refs_high = []
        for r in cand:
            if refs_high and (Xn[refs_high] @ Xn[r]).max() > c['DUP_HIGH']:
                continue
            refs_high.append(r)
            if len(refs_high) == N_REF:
                break
        if len(refs_high) < N_REF:
            refs_high = cand[:N_REF]
    else:
        refs_high = cand[:N_REF]
    ch = unit(Xn[refs_high].mean(0))
    # --- refs_low
    if c['LOW_MODE'] == 'baseline':
        refs_low = [int(r) for r in D.low_tr[a]]
    elif c['LOW_MODE'] == 'twin':
        # each high reference h_i gets its own twin: the silent naming-split image closest to h_i (DINOv2 cosine), so the two rows
        # match column by column and differ by the concept; no image twice, no near-duplicates, at most LOW_MAX_PER_CAT per category
        tr = D.tr
        ok = silent_mask(D, grp, tr) & ~np.isin(tr, refs_high)
        if c['H_MAX'] is not None:
            ok &= h_rows(D, tr, a) < c['H_MAX']
        rows = tr[ok]; Xr = P.Xn_tr[ok]
        refs_low, ncat, twin_cos = [], {}, []
        for h in refs_high:
            sims = Xr @ Xn[h]
            for i in np.argsort(-sims):
                r = int(rows[i])
                if r in refs_low or (refs_low and (Xn[refs_low] @ Xn[r]).max() > c['DUP']):
                    continue
                cat = D.category(r)
                if ncat.get(cat, 0) >= c['LOW_MAX_PER_CAT']:
                    continue
                ncat[cat] = ncat.get(cat, 0) + 1; refs_low.append(r); twin_cos.append(float(sims[i])); break
        out['twin_cos'] = twin_cos
    else:
        tr = D.tr
        ok = silent_mask(D, grp, tr) & ~np.isin(tr, refs_high)
        if c['H_MAX'] is not None:
            ok &= h_rows(D, tr, a) < c['H_MAX']
        rows = tr[ok]
        sims = P.Xn_tr[ok] @ ch
        order = np.argsort(-sims)
        refs_low, ncat = [], {}
        for i in order:
            r = int(rows[i])
            if refs_low and (Xn[refs_low] @ Xn[r]).max() > c['DUP']:
                continue
            cat = D.category(r)
            if ncat.get(cat, 0) >= c['LOW_MAX_PER_CAT']:
                continue
            ncat[cat] = ncat.get(cat, 0) + 1
            refs_low.append(r)
            if len(refs_low) == N_REF:
                break
        if len(refs_low) < N_REF:          # should not happen
            out['fallback'].append('refs_low: fewer than 9 silent rows, completed with baseline low_tr')
            for r in D.low_tr[a]:
                if int(r) not in refs_low and int(r) not in refs_high:
                    refs_low.append(int(r))
                if len(refs_low) == N_REF:
                    break
    cl = unit(Xn[refs_low].mean(0))
    # --- query pair
    zcol = D.Zev[:, a]
    order = np.argsort(-zcol, kind='stable')
    zmax = float(zcol.max())
    pos_cands = [int(D.ev[i]) for i in order[:c['N_POS_TOP']] if zcol[i] > 0 and zcol[i] >= c['Z_REL_MIN'] * zmax]
    if not pos_cands:
        return None
    ev = D.ev
    sil = silent_mask(D, grp, ev)
    hev = h_rows(D, ev, a)
    low_cos_med = float(np.median(Xn[refs_low] @ ch))
    pos_ok = []
    for pos in pos_cands:
        sp, fp = margins(D, refs_high, refs_low, pos, c['KNN'])
        inside = (not c['POS_INSIDE']) or (float(Xn[pos] @ ch) >= low_cos_med and fp >= c['POS_KNN_MIN'])
        pos_ok.append((pos, sp, fp, inside))
    if not any(o[3] for o in pos_ok):
        out['fallback'].append('query_pos: no top positive inside the concept region (cos to high centroid / kNN); constraint dropped')
        pos_ok = [(p_, sp, fp, True) for p_, sp, fp, _ in pos_ok]
    pairs = []

    def collect(level, use_cat, use_h):
        for pos, sp, fp, inside in pos_ok:
            if not inside:
                continue
            if D.key == 'coco' and use_cat and not D.labels[pos].any():
                continue
            ok = sil & (ev != pos)
            if use_cat == 'different':
                ok &= ~same_cat_mask(D, ev, pos)        # ImageNet: another wnid; COCO: no label in common with the positive
            elif use_cat:
                ok &= same_cat_mask(D, ev, pos)
            if use_h and c['H_NEG_MAX'] is not None:
                ok &= hev < c['H_NEG_MAX']
            negs = ev[ok]
            if len(negs) == 0:
                continue
            sims = Xn[negs] @ Xn[pos]
            for j in np.argsort(-sims)[:c['N_NEG_NEAR']]:
                neg = int(negs[j])
                sn, fn = margins(D, refs_high, refs_low, neg, c['KNN'])
                pairs.append(dict(pos=pos, neg=neg, margin=sp - sn, knn=fp - fn, cos=float(sims[j]), same_cat=int(use_cat is True), level=level))
    # cascade: same category + h < 0  ->  same category, z = 0 only  ->  any category + h < 0
    if c['NEG_CAT'] == 'different':
        collect(3, 'different', True)
    elif c['NEG_CAT']:
        collect(0, True, True)
    else:
        collect(2, False, True)
    if not pairs:
        out['fallback'].append('query_neg: no silent same-category held-out image with h < H_NEG_MAX; h constraint dropped (z = 0 only)')
        collect(1, True, False)
    if not pairs:
        out['fallback'].append('query_neg: no silent same-category held-out image at all; category relaxed (nearest silent image, h < H_NEG_MAX)')
        collect(2, False, True)
    if not pairs:
        return None
    good = [p for p in pairs if p['margin'] >= c['FLOOR'] and p['knn'] > c['KNN_FLOOR']]
    if good:
        if c['PAIR_OBJ'] == 'max_cos':
            best = max(good, key=lambda p: (p['cos'], -p['margin']))
        else:
            best = min(good, key=lambda p: (p['margin'], -p['cos']))
    else:
        out['fallback'].append(f"pair: no pair with margin >= {c['FLOOR']} and kNN margin > {c['KNN_FLOOR']}; the pair with the largest margin is kept")
        best = max(pairs, key=lambda p: (p['margin'], p['cos']))
    out.update(refs_high=refs_high, refs_low=refs_low, query_pos=best['pos'], query_neg=best['neg'],
               n_pairs=len(pairs), n_pairs_above_floor=len(good), pair_same_cat=best['same_cat'], neg_level=best['level'],
               n_pos_inside=sum(o[3] for o in pos_ok),
               n_pos_candidates=len(pos_cands), pos_rank_ev=int(np.where(D.ev[order] == best['pos'])[0][0]) + 1,
               cfg=c)
    return out


# ---------------------------------------------------------------- main: pool, baseline, sweep, sheets
def dataset_ids(D, rows):
    return [int(D.image_ids[r]) if D.key == 'coco' else int(r) for r in rows]


def load_pool():
    man = json.load(open(f'{ROOT}/human_exp/site/stimuli/manifest.json'))
    pool = {k: v for k, v in man['atoms'].items() if v['stratum'] in ('R', 'Delta')}
    assert len(pool) == 120
    return man, pool


def medians(rows, keys):
    out = {}
    for k in keys:
        v = [r[k] for r in rows if k in r and r[k] is not None]
        if v:
            out[k] = float(np.median(v))
    return out


MKEYS = ['m1_margin', 'm1_knn', 'm1_sign', 'm2_z_pos_rel', 'm2_z_neg', 'm2_namesakes_silent', 'm3_code_jaccard',
         'm4_row_cos', 'm4_same_cat_frac', 'm5_salt', 'm5_cd', 'pair_cos', 'pair_label_jaccard', 'high_mean_cos', 'low_h_max', 'h_neg']


def run_pool(D_all, names_all, pool, cfg, tag):
    res = {}
    for aid, e in pool.items():
        key, a = e['dataset'], int(aid.split('_')[1])
        D = D_all[key]
        rng = np.random.default_rng(1000003 * a + 7)
        t = select_trial(D, a, rng, cfg)
        if t is None:
            res[aid] = None; continue
        m = trial_metrics(D, a, t['refs_high'], t['refs_low'], t['query_pos'], t['query_neg'], names_all[key][a], CFG['KNN'])
        res[aid] = dict(t, metrics=m)
    served = [r for r in res.values() if r is not None]
    log(tag, 'served', len(served), 'of', len(pool), '| median m1', round(medians([r['metrics'] for r in served], ['m1_margin'])['m1_margin'], 4),
        '| sign>0', sum(r['metrics']['m1_sign'] > 0 for r in served), '| fallbacks', sum(bool(r['fallback']) for r in served))
    return res


def baseline_metrics(D_all, names_all, pool):
    res = {}
    for aid, e in pool.items():
        key, a = e['dataset'], int(aid.split('_')[1])
        D, P = D_all[key], prep(D_all[key])
        s = e['meta']['src']
        rh = [P.row_from_id(D, i) for i in s['refs_high']]; rl = [P.row_from_id(D, i) for i in s['refs_low']]
        pos, neg = P.row_from_id(D, s['query_pos']), P.row_from_id(D, s['query_neg'])
        assert D.z(neg, a) == 0.0 and abs(D.z(pos, a) - e['meta']['z_pos']) < 1e-4, aid
        res[aid] = dict(atom=a, dataset=key, refs_high=rh, refs_low=rl, query_pos=pos, query_neg=neg,
                        metrics=trial_metrics(D, a, rh, rl, pos, neg, names_all[key][a], CFG['KNN']))
    return res


def rel(p):
    return os.path.relpath(p, HERE)


def write_sheet(D_all, names_all, res_mine, res_base, path):
    H = ['<!doctype html><meta charset="utf-8"><title>A_feature_hardneg contact sheet</title>',
         '<body style="font-family:sans-serif;background:#fafafa"><h1>Lens A: hard negatives in DINOv2 space</h1>',
         '<p>For each of the 12 requested atoms: the rule of this lens (top) and the current manifest (bottom, grey). '
         'Rows: most activating (high), least activating (low); pair: query_pos (green frame), query_neg (red frame).</p>']
    im = lambda p, b='#ccc': f'<img src="{rel(p)}" width="96" height="96" style="object-fit:cover;border:3px solid {b};margin:1px">'
    for aid in SHEET_ATOMS:
        key, a = aid.split('_')[0], int(aid.split('_')[1])
        D, nm = D_all[key], names_all[key][a]
        H.append(f'<h2>{aid} &mdash; SALT: <b>{nm["salt"]}</b> ({nm["corr_salt"]:+.3f}) | CLIP-Dissect: <b>{nm["cd"]}</b> ({nm["corr_cd"]:+.3f})</h2>')
        for lab, r, bg in (('A_feature_hardneg', res_mine[aid], '#fff'), ('current manifest', res_base[aid], '#eee')):
            if r is None:
                H.append(f'<div style="background:{bg};padding:6px"><b>{lab}</b>: not served</div>'); continue
            m = r['metrics']
            H.append(f'<div style="background:{bg};padding:6px;margin:4px 0"><b>{lab}</b> &nbsp; '
                     f'm1 margin {m["m1_margin"]:+.3f} (kNN {m["m1_knn"]:+.2f}) | m2 z_pos/max {m["m2_z_pos_rel"]:.2f}, z_neg {m["m2_z_neg"]:.0f}, namesakes silent {m["m2_namesakes_silent"]} | '
                     f'm3 code Jaccard {m["m3_code_jaccard"]:.2f} | m4 row cos {m["m4_row_cos"]:.2f}, same-cat {m["m4_same_cat_frac"]:.2f} | '
                     f'm5 SALT {m["m5_salt"]} CD {m["m5_cd"]} | pair cos {m["pair_cos"]:.2f}'
                     + (f' | fallback: {"; ".join(r["fallback"])}' if r.get('fallback') else '') + '<br>'
                     f'<div>high: {"".join(im(D.path(x)) for x in r["refs_high"])}</div>'
                     f'<div>low:&nbsp; {"".join(im(D.path(x)) for x in r["refs_low"])}</div>'
                     f'<div>pair: {im(D.path(r["query_pos"]), "#2a2")} {im(D.path(r["query_neg"]), "#c22")} '
                     f'<span style="font-size:11px">pos: {prep(D).text[r["query_pos"]][:160]}<br>neg: {prep(D).text[r["query_neg"]][:160]}</span></div></div>')
    open(path, 'w').write('\n'.join(H))


def write_montage(D_all, names_all, res_mine, path, T=224):
    from PIL import Image, ImageDraw, ImageFont
    try:
        import matplotlib
        font = ImageFont.truetype(os.path.join(os.path.dirname(matplotlib.__file__), 'mpl-data/fonts/ttf/DejaVuSans.ttf'), 22)
        small = ImageFont.truetype(os.path.join(os.path.dirname(matplotlib.__file__), 'mpl-data/fonts/ttf/DejaVuSans.ttf'), 16)
    except Exception:
        font = small = ImageFont.load_default()
    pad, head = 6, 44
    bw = 9 * (T + pad) + 2 * (T + pad) + 60
    bh = head + 2 * (T + pad) + 10
    canvas = Image.new('RGB', (bw, bh * len(SHEET_ATOMS)), 'white')
    dr = ImageDraw.Draw(canvas)

    def thumb(p):
        with Image.open(p) as im:
            im = im.convert('RGB'); w, h = im.size; s = T / min(w, h)
            im = im.resize((max(T, round(w * s)), max(T, round(h * s))), Image.BICUBIC)
            l, t = (im.size[0] - T) // 2, (im.size[1] - T) // 2
            return im.crop((l, t, l + T, t + T))
    for bi, aid in enumerate(SHEET_ATOMS):
        key, a = aid.split('_')[0], int(aid.split('_')[1])
        D, nm, r = D_all[key], names_all[key][a], res_mine[aid]
        y0 = bi * bh
        if r is None:
            dr.text((8, y0 + 8), f'{aid}: not served', fill='black', font=font); continue
        m = r['metrics']
        dr.text((8, y0 + 6), f'{aid}   SALT: {nm["salt"]}   CD: {nm["cd"]}   m1 {m["m1_margin"]:+.3f} (kNN {m["m1_knn"]:+.2f})  '
                f'm3 {m["m3_code_jaccard"]:.2f}  m4 {m["m4_row_cos"]:.2f}/{m["m4_same_cat_frac"]:.2f}  z_pos/max {m["m2_z_pos_rel"]:.2f}', fill='black', font=font)
        for ri, (rows, lab) in enumerate(((r['refs_high'], 'HIGH'), (r['refs_low'], 'LOW'))):
            y = y0 + head + ri * (T + pad)
            dr.text((8, y + T // 2 - 10), lab, fill='black', font=small)
            for i, x in enumerate(rows):
                canvas.paste(thumb(D.path(x)), (60 + i * (T + pad), y))
        xq = 60 + 9 * (T + pad) + 20
        for ri, (x, lab, col) in enumerate(((r['query_pos'], 'POS', (40, 170, 40)), (r['query_neg'], 'NEG', (200, 40, 40)))):
            y = y0 + head + ri * (T + pad)
            canvas.paste(thumb(D.path(x)), (xq, y))
            dr.rectangle([xq - 3, y - 3, xq + T + 2, y + T + 2], outline=col, width=4)
            dr.text((xq + 6, y + 4), lab, fill=col, font=small)
        dr.line([0, y0 + bh - 2, bw, y0 + bh - 2], fill=(180, 180, 180), width=2)
    canvas.save(path, 'PNG', optimize=True)
    log('montage', canvas.size, path)


def run_sweep(D_all, names_all, pool):
    sweep = []
    # sweep: refs modes x floors
    for high_mode in ('top9', 'fps', 'dedup'):
        for low_mode in ('baseline', 'hardneg'):
            for floor in (0.0, 0.02, 0.05, 0.10):
                cfg = dict(HIGH_MODE=high_mode, LOW_MODE=low_mode, FLOOR=floor)
                res = run_pool(D_all, names_all, pool, cfg, f'sweep {high_mode}/{low_mode}/floor={floor}')
                served = [r for r in res.values() if r is not None]
                ms = [r['metrics'] for r in served]
                sweep.append(dict(cfg=dict(CFG, **cfg), served=len(served), n_fallback=sum(bool(r['fallback']) for r in served),
                                  n_sign_pos=sum(m['m1_sign'] > 0 for m in ms), n_knn_pos=sum(m['m1_knn'] > 0 for m in ms),
                                  medians=medians(ms, MKEYS)))
    # H_MAX sweep for refs_low (hardneg, fps, floor 0.02)
    for hmax in (None, 0.0, -1.0):
        cfg = dict(H_MAX=hmax)
        res = run_pool(D_all, names_all, pool, cfg, f'sweep H_MAX={hmax}')
        served = [r for r in res.values() if r is not None]; ms = [r['metrics'] for r in served]
        sweep.append(dict(cfg=dict(CFG, **cfg), served=len(served),
                          n_fallback=sum(bool(r['fallback']) for r in served),
                          n_sign_pos=sum(m['m1_sign'] > 0 for m in ms), n_knn_pos=sum(m['m1_knn'] > 0 for m in ms), medians=medians(ms, MKEYS)))
    for extra in (dict(PAIR_OBJ='max_cos'), dict(PAIR_OBJ='max_cos', FLOOR=0.05), dict(H_NEG_MAX=None), dict(FLOOR=0.03), dict(FLOOR=0.04),
                  dict(N_NEG_NEAR=10), dict(Z_REL_MIN=0.0), dict(Z_REL_MIN=0.75), dict(LOW_MAX_PER_CAT=9), dict(LOW_MAX_PER_CAT=2), dict(DUP_HIGH=0.75),
                  dict(POS_INSIDE=False), dict(POS_KNN_MIN=0.8)):
        res = run_pool(D_all, names_all, pool, extra, f'sweep {extra}')
        served = [r for r in res.values() if r is not None]; ms = [r['metrics'] for r in served]
        sweep.append(dict(cfg=dict(CFG, **extra), served=len(served), n_fallback=sum(bool(r['fallback']) for r in served),
                          n_sign_pos=sum(m['m1_sign'] > 0 for m in ms), n_knn_pos=sum(m['m1_knn'] > 0 for m in ms), medians=medians(ms, MKEYS)))
    json.dump(sweep, open(f'{HERE}/sweep.json', 'w'), indent=1)
    return sweep


def main():
    man, pool = load_pool()
    D_all, names_all = {}, {}
    for key in KEYS:
        D = Data(key); names = load_names(key); D.set_namesakes(names)
        prep(D); D_all[key] = D; names_all[key] = names
        log(key, 'ready', D.N, 'rows')
    base = baseline_metrics(D_all, names_all, pool)
    log('baseline median m1', medians([r['metrics'] for r in base.values()], ['m1_margin', 'm1_knn'])['m1_margin'])
    if '--sweep' in sys.argv:
        run_sweep(D_all, names_all, pool); log('sweep written'); return
    sweep = json.load(open(f'{HERE}/sweep.json')) if os.path.exists(f'{HERE}/sweep.json') else []
    # final rule = CFG
    mine = run_pool(D_all, names_all, pool, {}, 'FINAL')
    served = {k: v for k, v in mine.items() if v is not None}
    per_atom = {}
    for aid in pool:
        r, b = mine[aid], base[aid]
        D = D_all[pool[aid]['dataset']]
        per_atom[aid] = dict(
            names=dict(salt=names_all[D.key][r['atom'] if r else b['atom']]['salt'], cd=names_all[D.key][b['atom']]['cd']),
            mine=None if r is None else dict(refs_high=dataset_ids(D, r['refs_high']), refs_low=dataset_ids(D, r['refs_low']),
                                             query_pos=dataset_ids(D, [r['query_pos']])[0], query_neg=dataset_ids(D, [r['query_neg']])[0],
                                             rows=dict(refs_high=r['refs_high'], refs_low=r['refs_low'], query_pos=r['query_pos'], query_neg=r['query_neg']),
                                             fallback=r['fallback'], n_pairs=r['n_pairs'], n_pairs_above_floor=r['n_pairs_above_floor'],
                                             neg_level=r['neg_level'], n_pos_inside=r['n_pos_inside'],
                                             pos_rank_ev=r['pos_rank_ev'], metrics=r['metrics']),
            baseline=dict(metrics=b['metrics']))
    summary = dict(
        rule=CFG, n_pool=len(pool), n_served=len(served), n_fallback=sum(bool(r['fallback']) for r in served.values()),
        fallbacks={aid: r['fallback'] for aid, r in served.items() if r['fallback']},
        medians_mine=medians([r['metrics'] for r in served.values()], MKEYS),
        medians_baseline=medians([b['metrics'] for b in base.values()], MKEYS),
        means_mine={k: float(np.mean([r['metrics'][k] for r in served.values()])) for k in MKEYS},
        means_baseline={k: float(np.mean([b['metrics'][k] for b in base.values()])) for k in MKEYS},
        n_sign_pos=dict(mine=sum(r['metrics']['m1_sign'] > 0 for r in served.values()), baseline=sum(b['metrics']['m1_sign'] > 0 for b in base.values())),
        n_knn_pos=dict(mine=sum(r['metrics']['m1_knn'] > 0 for r in served.values()), baseline=sum(b['metrics']['m1_knn'] > 0 for b in base.values())),
        per_dataset={key: dict(mine=medians([r['metrics'] for a, r in served.items() if r['dataset'] == key], MKEYS),
                               baseline=medians([b['metrics'] for a, b in base.items() if b['dataset'] == key], MKEYS)) for key in KEYS},
        sweep=sweep, id_kind='coco: COCO image id; imagenet: val row (= id)')
    json.dump(dict(summary=summary, atoms=per_atom), open(f'{HERE}/metrics.json', 'w'), indent=1)
    write_sheet(D_all, names_all, mine, base, f'{HERE}/contact_sheet.html')
    write_montage(D_all, names_all, mine, f'{HERE}/montage.png')
    log('done')
    return summary


if __name__ == '__main__':
    main()
